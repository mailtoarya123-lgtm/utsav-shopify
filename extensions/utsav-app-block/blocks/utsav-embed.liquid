{% comment %}
  Utsav — Indian Festival Themes
  App Embed Block (Target: body)
  Appears directly in the Theme Customizer 'App embeds' tab!
{% endcomment %}

{% if block.settings.enable_decor %}
  {{ 'festival-themes.css' | asset_url | stylesheet_tag }}

  <script>
    window.__UTSAV_CONFIG__ = {
      shopDomain: {{ shop.permanent_domain | default: shop.myshopify_domain | default: shop.domain | json }},
      festivalId: {{ block.settings.festival_id | default: "diwali" | json }},
      festivalName: {{ block.settings.festival_name | default: "Diwali" | json }},
      festivalEmoji: "🪔",
      enableEffects: true,
      enableBanner: false,
      enableCountdown: false,
      enableColorSwap: true,
      enableSeriesLights: {{ block.settings.enable_series_lights | default: true | json }},
      seriesLightsTheme: {{ block.settings.series_lights_theme | default: "warm_gold" | json }},
      seriesLightsMode: {{ block.settings.series_lights_mode | default: "twinkle" | json }},
      diyaStyle: {{ block.settings.diya_style | default: "royal_brass" | json }},
      flameGlow: {{ block.settings.flame_glow | default: "warm_radiance" | json }},
      diyaSize: {{ block.settings.diya_size | default: "medium" | json }},
      diyaPosition: {{ block.settings.diya_position | default: "bottom_corners" | json }},
      diyaMarginX: {{ block.settings.diya_margin_x | default: 18 | json }},
      diyaMarginY: {{ block.settings.diya_margin_y | default: 18 | json }},
      diyaHideOnMobile: {{ block.settings.diya_hide_on_mobile | default: false | json }},
      fireworksFrequency: {{ block.settings.fireworks_frequency | default: "subtle" | json }},
      garlandLayout: {{ block.settings.garland_layout | default: "top_and_sides" | json }},
      garlandPlacement: {{ block.settings.garland_placement | default: "below_header" | json }},
      garlandScrollMode: {{ block.settings.garland_scroll_mode | default: "natural_scroll" | json }},
      garlandOffset: {{ block.settings.garland_offset | default: 0 | json }},
      garlandStyle: {{ block.settings.garland_style | default: "mango_marigold" | json }},
      kiteCount: {{ block.settings.kite_count | default: 2 | json }},
      kiteSpeed: {{ block.settings.kite_speed | default: "gentle" | json }},
      moonPosition: {{ block.settings.moon_position | default: "top_right" | json }},
      palette: {
        primary: "#D4AF37",
        secondary: "#FF6B35",
        background: "#1A0A00",
        glow: "rgba(212, 175, 55, 0.35)"
      }
    };
  </script>
  <script src="{{ 'festive-effects.js' | asset_url }}" defer></script>
{% endif %}

{% schema %}
{
  "name": "🪔 Utsav Festival Decor",
  "target": "body",
  "settings": [
    {
      "type": "checkbox",
      "id": "enable_decor",
      "label": "Enable Festive Visuals",
      "default": true
    },
    {
      "type": "select",
      "id": "festival_id",
      "label": "Festival Theme",
      "options": [
        { "value": "diwali", "label": "🪔 Diwali (Deepavali)" },
        { "value": "dussehra", "label": "🏹 Dussehra (Vijayadashami)" },
        { "value": "sankranti", "label": "🪁 Makar Sankranti / Pongal" },
        { "value": "eid", "label": "🌙 Eid ul-Fitr" }
      ],
      "default": "diwali"
    },
    {
      "type": "header",
      "content": "🌿 Garland & Series Lights"
    },
    {
      "type": "select",
      "id": "garland_layout",
      "label": "Garland Placement",
      "options": [
        { "value": "top_and_sides", "label": "Top Toran & Both Side Cascades" },
        { "value": "top_only", "label": "Top Toran Only" },
        { "value": "sides_only", "label": "Side Cascades Only" },
        { "value": "off", "label": "Off (No Garland)" }
      ],
      "default": "top_and_sides"
    },
    {
      "type": "select",
      "id": "garland_placement",
      "label": "Garland Docking Position",
      "options": [
        { "value": "below_header", "label": "🌿 Below Navigation (Recommended)" },
        { "value": "top_fixed", "label": "Top of Screen (Fixed 0px)" }
      ],
      "default": "below_header"
    },
    {
      "type": "checkbox",
      "id": "enable_series_lights",
      "label": "Enable Series Lights (Diwali Only)",
      "default": true
    },
    {
      "type": "select",
      "id": "series_lights_theme",
      "label": "Diwali Series Lights Palette",
      "options": [
        { "value": "warm_gold", "label": "🌟 Warm Golden Fairy Lights" },
        { "value": "festive_multicolor", "label": "🌈 Multi-Color Festive Jewels" },
        { "value": "amber_radiance", "label": "🕯️ Deep Amber Sacred Warmth" },
        { "value": "pearl_white", "label": "⚪ Moonlit Pearl Radiance" },
        { "value": "off", "label": "🌿 Floral Garland Only (No Lights)" }
      ],
      "default": "warm_gold"
    },
    {
      "type": "select",
      "id": "series_lights_mode",
      "label": "Series Lights Animation",
      "options": [
        { "value": "chaser", "label": "⚡ Cascading Chaser Wave" },
        { "value": "twinkle", "label": "✨ Gentle Twinkle & Shimmer" },
        { "value": "steady", "label": "💡 Steady Luminous Glow" }
      ],
      "default": "twinkle"
    },
    {
      "type": "header",
      "content": "🪔 Diwali Customizations"
    },
    {
      "type": "select",
      "id": "diya_style",
      "label": "Diya Material & Style",
      "options": [
        { "value": "royal_brass", "label": "🏺 Royal Brass (Molten Gold)" },
        { "value": "terracotta_clay", "label": "🧱 Traditional Terracotta (Rustic Clay)" },
        { "value": "antique_copper", "label": "🪓 Antique Copper (Warm Hammered)" },
        { "value": "minimal_contemporary", "label": "📐 Minimal Contemporary (Satin Bronze)" },
        { "value": "marigold_urli", "label": "🌸 Festive Ornamental (Marigold Urli)" }
      ],
      "default": "royal_brass"
    },
    {
      "type": "select",
      "id": "flame_glow",
      "label": "Flame Glow Aura",
      "options": [
        { "value": "warm_radiance", "label": "Warm Radiance" },
        { "value": "sacred_flicker", "label": "Sacred Flicker" },
        { "value": "divine_aura", "label": "Divine Aura (Wide Bloom)" },
        { "value": "sparkling_wick", "label": "Sparkling Wick" }
      ],
      "default": "warm_radiance"
    },
    {
      "type": "select",
      "id": "diya_size",
      "label": "Diya Dimensions",
      "options": [
        { "value": "small", "label": "Small (56px — Minimal)" },
        { "value": "medium", "label": "Medium (76px — Standard)" },
        { "value": "large", "label": "Large (96px — Majestic)" },
        { "value": "xlarge", "label": "X-Large (116px — Akhand Maha Diya)" }
      ],
      "default": "medium"
    },
    {
      "type": "select",
      "id": "diya_position",
      "label": "Diya Placement",
      "options": [
        { "value": "bottom_corners", "label": "Both Bottom Corners" },
        { "value": "bottom_left", "label": "Bottom-Left Corner Only" },
        { "value": "bottom_right", "label": "Bottom-Right Corner Only" },
        { "value": "top_corners", "label": "Both Top Corners" },
        { "value": "top_left", "label": "Top-Left Corner Only" },
        { "value": "top_right", "label": "Top-Right Corner Only" },
        { "value": "all_four", "label": "All 4 Corners" }
      ],
      "default": "bottom_corners"
    },
    {
      "type": "number",
      "id": "diya_margin_x",
      "label": "Horizontal Edge Offset (px)",
      "default": 18
    },
    {
      "type": "number",
      "id": "diya_margin_y",
      "label": "Vertical Edge Offset (px)",
      "default": 18
    },
    {
      "type": "checkbox",
      "id": "diya_hide_on_mobile",
      "label": "Hide Diyas on Mobile (<480px)",
      "default": false
    },
    {
      "type": "select",
      "id": "fireworks_frequency",
      "label": "Fireworks Frequency",
      "options": [
        { "value": "subtle", "label": "Subtle Willow (7.5s)" },
        { "value": "moderate", "label": "Moderate (4.2s)" },
        { "value": "celebratory", "label": "Celebratory (2.2s)" },
        { "value": "off", "label": "Off (No Fireworks)" }
      ],
      "default": "subtle"
    },
    {
      "type": "header",
      "content": "🪁 Sankranti / Pongal Customizations"
    },
    {
      "type": "select",
      "id": "kite_count",
      "label": "Kites in Flight",
      "options": [
        { "value": "1", "label": "1 Kite (Minimalist)" },
        { "value": "2", "label": "2 Kites (Balanced)" },
        { "value": "4", "label": "4 Kites (Festive)" }
      ],
      "default": "2"
    },
    {
      "type": "select",
      "id": "kite_speed",
      "label": "Flight Pace",
      "options": [
        { "value": "gentle", "label": "Gentle Breeze (Slow)" },
        { "value": "moderate", "label": "Active Breeze" }
      ],
      "default": "gentle"
    },
    {
      "type": "header",
      "content": "🌙 Eid Customizations"
    },
    {
      "type": "select",
      "id": "moon_position",
      "label": "Crescent Moon Placement",
      "options": [
        { "value": "top_right", "label": "Top-Right Corner" },
        { "value": "top_left", "label": "Top-Left Corner" }
      ],
      "default": "top_right"
    }
  ]
}
{% endschema %}
