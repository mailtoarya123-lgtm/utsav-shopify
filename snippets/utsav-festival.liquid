          </g>

          <!-- Golden Brass Temple Bell (Ghanti) -->
          <g id="utsavBrassBell">
            <path d="M -6 0 C -5 6 -8 11 -8 13 L 8 13 C 8 11 5 6 6 0 Z" fill="url(#utsavBellGold)"/>
            <ellipse cx="0" cy="13" rx="8" ry="2" fill="#B78103"/>
