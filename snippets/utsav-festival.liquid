    // ─── 5. Web Audio Auspicious Bell Synthesizer ───────────────────────────
    function playTempleBell() {
      try {
        const AudioCtx = window.AudioContext || window.webkitAudioContext;
        if (!AudioCtx) return;
        const ctx = new AudioCtx();
        const osc = ctx.createOscillator();
        const gain = ctx.createGain();
        osc.type = 'sine';
        osc.frequency.setValueAtTime(880, ctx.currentTime);
        osc.frequency.exponentialRampToValueAtTime(440, ctx.currentTime + 1.2);
        gain.gain.setValueAtTime(0.08, ctx.currentTime);
        gain.gain.exponentialRampToValueAtTime(0.0001, ctx.currentTime + 1.2);
        osc.connect(gain);
        gain.connect(ctx.destination);
        osc.start();
        osc.stop(ctx.currentTime + 1.2);
      } catch (e) {}
    }

    // ─── 6. Fireworks Engine (Controlled strictly by festival) ──────────────
    const canvas = document.getElementById('utsav-fireworks-canvas');
    let ctx = null;
    let sparks = [];
    let fireworkInterval = null;
    let animFrameId = null;

    if (canvas) {
      ctx = canvas.getContext('2d');
      function resizeCanvas() {
        canvas.width = window.innerWidth;
        canvas.height = window.innerHeight;
      }
      window.addEventListener('resize', resizeCanvas);
      resizeCanvas();
    }

    function launchSparks(x, y, count, palette) {
      for (let i = 0; i < count; i++) {
        const angle = Math.random() * Math.PI * 2;
        const speed = 1.0 + Math.random() * 2.5;
        sparks.push({
          x: x, y: y,
          vx: Math.cos(angle) * speed,
          vy: Math.sin(angle) * speed,
          color: palette[Math.floor(Math.random() * palette.length)],
          size: 1.2 + Math.random() * 1.6,
          alpha: 1.0,
          decay: 0.012 + Math.random() * 0.008,
          gravity: 0.035
        });
      }
    }

    function triggerFirework(config) {
      const isDiwali = (config.festivalId || '').toLowerCase().includes('diwali');
      if (!isDiwali || config.fireworksFrequency === 'off') return;

      const style = config.fireworksStyle || 'kamuro_willow';

      if (style === 'anar_fountain') {
        const isLeft = Math.random() < 0.5;
        const originX = isLeft ? 55 : window.innerWidth - 55;
        const originY = window.innerHeight - 35;
        for (let i = 0; i < 22; i++) {
          sparks.push({
            x: originX + (Math.random() * 20 - 10),
            y: originY,
            vx: (Math.random() - 0.5) * 1.8,
            vy: -(3.5 + Math.random() * 3.5),
            color: ['#FFD700', '#FFF8DC', '#FFA500', '#FF8C00'][Math.floor(Math.random() * 4)],
            size: 1.3 + Math.random() * 1.5,
            alpha: 1.0,
            decay: 0.014 + Math.random() * 0.01,
            gravity: 0.12
          });
        }
      } else if (style === 'peony_multicolor') {
        const burstX = Math.random() < 0.5 
          ? 60 + Math.random() * (window.innerWidth * 0.28) 
          : window.innerWidth * 0.68 + Math.random() * (window.innerWidth * 0.26);
        const burstY = 70 + Math.random() * (window.innerHeight * 0.26);
        const palette = ['#FF5722', '#E91E63', '#00E676', '#FFD700', '#00BCD4', '#FFF'];
        launchSparks(burstX, burstY, 34, palette);
      } else if (style === 'chakri_whirl') {
        const burstX = Math.random() < 0.5 
          ? 70 + Math.random() * (window.innerWidth * 0.26) 
          : window.innerWidth * 0.70 + Math.random() * (window.innerWidth * 0.24);
        const burstY = 75 + Math.random() * (window.innerHeight * 0.22);
        for (let i = 0; i < 30; i++) {
          const a = (i / 30) * Math.PI * 2;
          const spd = 1.2 + (i % 3) * 0.6;
          sparks.push({
            x: burstX, y: burstY,
            vx: Math.cos(a) * spd,
            vy: Math.sin(a) * spd,
            color: '#FFD700',
            size: 1.4,
            alpha: 1.0,
            decay: 0.015,
            gravity: 0.02
          });
        }
      } else {
        const burstX = Math.random() < 0.5 
          ? 60 + Math.random() * (window.innerWidth * 0.28) 
          : window.innerWidth * 0.68 + Math.random() * (window.innerWidth * 0.26);
        const burstY = 70 + Math.random() * (window.innerHeight * 0.26);
        const count = 28 + Math.floor(Math.random() * 12);
        const willowColors = ["#FFD700", "#FFDF73", "#FFA500", "#FFF8DC", "#FF8C00"];
        for (let i = 0; i < count; i++) {
          const angle = Math.random() * Math.PI * 2;
          const speed = 0.9 + Math.random() * 2.0;
          sparks.push({
            x: burstX, y: burstY,
            vx: Math.cos(angle) * speed,
            vy: Math.sin(angle) * speed,
            color: willowColors[Math.floor(Math.random() * willowColors.length)],
            size: 1.3 + Math.random() * 1.5,
            alpha: 1.0,
            decay: 0.009 + Math.random() * 0.007,
            gravity: 0.028
          });
        }
      }

      if (config.fireworksSound === 'temple_bells') {
        playTempleBell();
      }
    }

    function renderFireworks() {
      if (!ctx || !canvas) return;
      ctx.clearRect(0, 0, canvas.width, canvas.height);
      for (let i = sparks.length - 1; i >= 0; i--) {
        const s = sparks[i];
        s.x += s.vx;
        s.y += s.vy;
        s.vx *= 0.97;
        s.vy *= 0.97;
        s.vy += (s.gravity || 0.035);
        s.alpha -= s.decay;

        if (s.alpha > 0) {
          ctx.save();
          ctx.globalAlpha = s.alpha;
          ctx.beginPath();
          ctx.arc(s.x, s.y, s.size, 0, Math.PI * 2);
          ctx.fillStyle = s.color;
          ctx.shadowColor = s.color;
          ctx.shadowBlur = 6;
          ctx.fill();
          ctx.restore();
        } else {
          sparks.splice(i, 1);
        }
      }
      animFrameId = requestAnimationFrame(renderFireworks);
    }

    function stopFireworks() {
      if (fireworkInterval) {
        clearInterval(fireworkInterval);
        fireworkInterval = null;
      }
      if (animFrameId) {
        cancelAnimationFrame(animFrameId);
        animFrameId = null;
      }
      sparks = [];
      if (ctx && canvas) {
        ctx.clearRect(0, 0, canvas.width, canvas.height);
      }
      if (canvas) canvas.style.display = 'none';
    }

    function startFireworks(config) {
      stopFireworks();
      if (!canvas || config.fireworksFrequency === 'off') return;
      canvas.style.display = 'block';
      renderFireworks();
      const ms = config.fireworksFrequency === 'celebratory' ? 2400 : config.fireworksFrequency === 'moderate' ? 4500 : 8500;
      setTimeout(() => triggerFirework(config), 1200);
      fireworkInterval = setInterval(() => triggerFirework(config), ms);
    }

    // ─── 6.5 Christmas Snowfall Engine ───────────────────────────────────────
    let snowAnimId = null;
    let snowCanvas = null;

    function stopSnowfall() {
      if (snowAnimId) {
        cancelAnimationFrame(snowAnimId);
        snowAnimId = null;
      }
      if (snowCanvas) {
        snowCanvas.remove();
        snowCanvas = null;
      }
    }

    function startSnowfall() {
      stopSnowfall();
      snowCanvas = document.createElement('canvas');
      snowCanvas.id = 'utsav-snowfall-canvas';
      snowCanvas.style.cssText = 'position:fixed;top:0;left:0;width:100vw;height:100vh;pointer-events:none;z-index:9988;';
      document.body.appendChild(snowCanvas);

      const ctx = snowCanvas.getContext('2d');
      function resize() {
        if (!snowCanvas) return;
        snowCanvas.width = window.innerWidth;
        snowCanvas.height = window.innerHeight;
      }
      resize();
      window.addEventListener('resize', resize);

      const count = window.innerWidth < 600 ? 24 : 50;
      const flakes = [];
      for (let i = 0; i < count; i++) {
        flakes.push({
          x: Math.random() * window.innerWidth,
          y: Math.random() * window.innerHeight,
          r: 1.5 + Math.random() * 2.5,
          d: Math.random() * count,
          speed: 0.6 + Math.random() * 0.8,
          sway: Math.random() * 0.02
        });
      }

      function renderSnow() {
        if (!snowCanvas) return;
        ctx.clearRect(0, 0, snowCanvas.width, snowCanvas.height);
        ctx.fillStyle = 'rgba(255, 255, 255, 0.85)';
        ctx.beginPath();
        for (let i = 0; i < flakes.length; i++) {
          const f = flakes[i];
          ctx.moveTo(f.x, f.y);
          ctx.arc(f.x, f.y, f.r, 0, Math.PI * 2, true);
          f.y += f.speed;
          f.x += Math.sin(f.d) * 0.5;
          f.d += f.sway;
          if (f.y > snowCanvas.height) {
            f.y = -10;
            f.x = Math.random() * snowCanvas.width;
          }
        }
        ctx.fill();
        snowAnimId = requestAnimationFrame(renderSnow);
      }
      renderSnow();
    }

    // ─── 7. Interactive Shopper Blessing (Diwali Diyas) ─────────────────────
    const blessings = [
      "✨ शुभ दीपावली! May light & prosperity bless your home ✨",
      "🪔 Shubh Deepavali! May your year shine bright ✨",
      "✨ शुभ लाभ! Wishing you boundless joy & abundance ✨",
      "🪔 Happy Diwali! Warm festive blessings to you & your family ✨"
    ];

    function showBlessing(x, y) {
      playTempleBell();
      const toast = document.createElement('div');
      toast.className = 'utsav-blessing-toast';
      toast.style.left = Math.min(Math.max(x, 140), window.innerWidth - 140) + 'px';
      toast.style.top = (y - 30) + 'px';
      toast.textContent = blessings[Math.floor(Math.random() * blessings.length)];
      document.body.appendChild(toast);
      setTimeout(() => toast.remove(), 2600);
      launchSparks(x, y, 16, ['#FFD700', '#FFA500', '#FFF8DC']);
    }

    // Tap-to-bless interaction (Click & Keyboard Accessible)
    ['utsavDiyaBL', 'utsavDiyaBR', 'utsavDiyaTL', 'utsavDiyaTR'].forEach(id => {
      const el = document.getElementById(id);
      if (el) {
        el.setAttribute('role', 'button');
        el.setAttribute('tabindex', '0');
        el.setAttribute('aria-label', 'Tap Diya for Festive Blessing');
        const trigger = () => {
          const rect = el.getBoundingClientRect();
          showBlessing(rect.left + rect.width / 2, rect.top);
        };
        el.addEventListener('click', trigger);
        el.addEventListener('keydown', (e) => {
          if (e.key === 'Enter' || e.key === ' ') {
            e.preventDefault();
            trigger();
          }
        });
      }
    });

    // Suspend fireworks rendering loop when browser tab is inactive to protect CPU
    document.addEventListener('visibilitychange', () => {
      if (document.hidden) {
        if (animFrameId) {
          cancelAnimationFrame(animFrameId);
          animFrameId = null;
        }
      } else {
        if (canvas && canvas.style.display === 'block' && !animFrameId) {
          renderFireworks();
        }
      }
    });

    // ─── 8. Master Strict Festival Applicator (Zero Effect Mixing) ───────────
    function applyFestival(festivalId, userConfig) {
      const fest = (festivalId || 'diwali').toLowerCase();
      const isDiwali = fest.includes('diwali');
      const isDussehra = fest.includes('dussehra');
      const isSankranti = fest.includes('sankranti') || fest.includes('pongal');
      const isChristmas = fest.includes('christmas');
      const isVishu = fest === 'vishu';
      const isHalloween = fest.includes('halloween');

      // Default safe config
      const config = {
        festivalId: fest,
        garlandLayout: userConfig.garlandLayout || 'top_and_sides',
        garlandPlacement: userConfig.garlandPlacement || 'below_header',
        garlandScrollMode: userConfig.garlandScrollMode || 'natural_scroll',
        garlandOffset: userConfig.garlandOffset || 0,
        garlandStyle: userConfig.garlandStyle || 'mango_marigold',
        enableSeriesLights: userConfig.enableSeriesLights !== undefined ? userConfig.enableSeriesLights : (userConfig.seriesLightsTheme !== 'off'),
        seriesLightsTheme: userConfig.seriesLightsTheme || 'warm_gold',
        seriesLightsMode: userConfig.seriesLightsMode || 'twinkle',
        diyaStyle: userConfig.diyaStyle || 'royal_brass',
        flameGlow: userConfig.flameGlow || 'sacred_flicker',
        diyaSize: userConfig.diyaSize || 'medium',
        diyaPosition: userConfig.diyaPosition || 'bottom_corners',
        diyaMarginX: userConfig.diyaMarginX !== undefined ? parseInt(userConfig.diyaMarginX, 10) : 18,
        diyaMarginY: userConfig.diyaMarginY !== undefined ? parseInt(userConfig.diyaMarginY, 10) : 18,
        diyaHideOnMobile: Boolean(userConfig.diyaHideOnMobile),
        fireworksStyle: userConfig.fireworksStyle || 'kamuro_willow',
        fireworksFrequency: userConfig.fireworksFrequency || 'subtle',
        fireworksSound: userConfig.fireworksSound || 'muted',
        bannerText: userConfig.bannerText || null
      };

      // ─── A. GARLANDS (Distinct Visual Styling per Festival) ───────────────
      const topContainer = document.getElementById('utsav-top-garland');
      const leftContainer = document.getElementById('utsav-garland-left');
      const rightContainer = document.getElementById('utsav-garland-right');

      const isEligibleForGarlands = config.garlandLayout !== 'off';
      const layout = config.garlandLayout;
      const showTop = isEligibleForGarlands && (layout === 'top_and_sides' || layout === 'top_only');
      const showSides = isEligibleForGarlands && (layout === 'top_and_sides' || layout === 'sides_only');

      function computeHeaderDockOffset() {
        if (config.garlandPlacement === 'top_fixed') {
          return parseInt(config.garlandOffset, 10) || 0;
        }

        // 1. Primary: Measure MainContent or main element offsetTop (Online Store 2.0 standard)
        const mainEl = document.getElementById('MainContent') || document.querySelector('main');
        if (mainEl && mainEl.offsetTop > 0) {
          return mainEl.offsetTop + (parseInt(config.garlandOffset, 10) || 0);
        }

        // 2. Fallback: Measure header element rect bottom relative to document
        const header = document.querySelector(
          '.header-group, sticky-header, .header-wrapper, #shopify-section-header, header.header, .site-header'
        );
        if (header) {
          const rect = header.getBoundingClientRect();
          const pageBottom = rect.bottom + window.scrollY;
          if (pageBottom > 0) {
            return Math.round(pageBottom) + (parseInt(config.garlandOffset, 10) || 0);
          }
        }

        return parseInt(config.garlandOffset, 10) || 0;
      }

      function positionGarlands() {
        if (!isEligibleForGarlands || config.garlandLayout === 'off') return;
        const dockTop = computeHeaderDockOffset();
        const isSticky = config.garlandScrollMode === 'sticky';

        if (topContainer) {
          topContainer.style.position = isSticky ? 'fixed' : 'absolute';
          if (isSticky) {
            const header = document.querySelector('sticky-header, .header-wrapper, header.header');
            const hRect = header ? header.getBoundingClientRect() : null;
            topContainer.style.top = (hRect ? Math.max(0, hRect.bottom) : dockTop) + 'px';
          } else {
            topContainer.style.top = dockTop + 'px';
          }
        }

        if (leftContainer) {
          leftContainer.style.position = isSticky ? 'fixed' : 'absolute';
          leftContainer.style.top = (isSticky ? (topContainer ? topContainer.style.top : dockTop + 'px') : (dockTop + 'px'));
        }

        if (rightContainer) {
          rightContainer.style.position = isSticky ? 'fixed' : 'absolute';
          rightContainer.style.top = (isSticky ? (topContainer ? topContainer.style.top : dockTop + 'px') : (dockTop + 'px'));
        }
      }

      if (topContainer) {
        if (showTop) {
          topContainer.innerHTML = getTopToranSVG(
            fest,
            config.garlandStyle,
            config.seriesLightsTheme,
            config.seriesLightsMode,
            config.enableSeriesLights
          );
          topContainer.style.display = 'block';
        } else {
          topContainer.style.display = 'none';
          topContainer.innerHTML = '';
        }
      }

      if (leftContainer) {
        if (showSides) {
          leftContainer.innerHTML = getSideGarlandSVG(
            fest,
            config.garlandStyle,
            config.seriesLightsTheme,
            config.seriesLightsMode,
            config.enableSeriesLights,
            true
          );
          leftContainer.style.display = 'block';
        } else {
          leftContainer.style.display = 'none';
          leftContainer.innerHTML = '';
        }
      }

      if (rightContainer) {
        if (showSides) {
          rightContainer.innerHTML = getSideGarlandSVG(
            fest,
            config.garlandStyle,
            config.seriesLightsTheme,
            config.seriesLightsMode,
            config.enableSeriesLights,
            false
          );
          rightContainer.style.display = 'block';
        } else {
          rightContainer.style.display = 'none';
          rightContainer.innerHTML = '';
        }
      }

      // Position garlands below header threshold
      positionGarlands();
      window.addEventListener('resize', positionGarlands);
      setTimeout(positionGarlands, 150);
      setTimeout(positionGarlands, 800);

      if (window.ResizeObserver) {
        const observed = document.querySelector('.header-group, sticky-header, .header-wrapper, header, #MainContent');
        if (observed) {
          const ro = new ResizeObserver(() => positionGarlands());
          ro.observe(observed);
        }
      }

      // ─── B. CORNER ELEMENTS (All 22 Festivals Authentic Motifs) ────────────
      const diyaContainer = document.getElementById('utsav-corner-container');
      if (diyaContainer) {
        if (!config.diyaHideOnMobile || window.innerWidth > 480) {
          diyaContainer.style.display = 'block';
          const sizePx = config.diyaSize === 'small' ? 56 : config.diyaSize === 'medium' ? 76 : config.diyaSize === 'large' ? 96 : 116;
          const cornerSvg = getFestivalCornerSVG(fest, sizePx, config);

          const bl = document.getElementById('utsavDiyaBL');
          const br = document.getElementById('utsavDiyaBR');
          const tl = document.getElementById('utsavDiyaTL');
          const tr = document.getElementById('utsavDiyaTR');

          const pos = config.diyaPosition;
          const mX = config.diyaMarginX;
          const mY = config.diyaMarginY;

          if (bl) {
            bl.innerHTML = cornerSvg;
            bl.style.bottom = mY + 'px';
            bl.style.left = mX + 'px';
            bl.style.display = (pos === 'bottom_corners' || pos === 'bottom_left' || pos === 'all_four') ? 'block' : 'none';
          }
          if (br) {
            br.innerHTML = cornerSvg;
            br.style.bottom = mY + 'px';
            br.style.right = mX + 'px';
            br.style.display = (pos === 'bottom_corners' || pos === 'bottom_right' || pos === 'all_four') ? 'block' : 'none';
          }
          if (tl) {
            tl.innerHTML = cornerSvg;
            tl.style.top = mY + 'px';
            tl.style.left = mX + 'px';
            tl.style.display = (pos === 'top_corners' || pos === 'top_left' || pos === 'all_four') ? 'block' : 'none';
          }
          if (tr) {
            tr.innerHTML = cornerSvg;
            tr.style.top = mY + 'px';
            tr.style.right = mX + 'px';
            tr.style.display = (pos === 'top_corners' || pos === 'top_right' || pos === 'all_four') ? 'block' : 'none';
          }
        } else {
          diyaContainer.style.display = 'none';
          ['utsavDiyaBL', 'utsavDiyaBR', 'utsavDiyaTL', 'utsavDiyaTR'].forEach(id => {
            const el = document.getElementById(id);
            if (el) { el.innerHTML = ''; el.style.display = 'none'; }
          });
        }
      }

      // ─── C. FIREWORKS & SNOWFALL (Zero Mixing per Festival) ────────────────
      if (isDiwali) {
        stopSnowfall();
        startFireworks(config);
      } else if (isChristmas) {
        stopFireworks();
        startSnowfall();
      } else if (isNewYear) {
        stopSnowfall();
        startFireworks({ fireworksFrequency: 'subtle', fireworksStyle: 'peony_multicolor' });
      } else {
        stopFireworks();
        stopSnowfall();
      }

      // ─── D. AMBIENT VIGNETTE (STRICTLY DIWALI ONLY) ────────────────────────
      const vignette = document.getElementById('utsavVignette');
      if (vignette) {
        vignette.style.display = isDiwali ? 'block' : 'none';
      }

      // ─── E. BANNER (Culturally Authentic Greetings for All 22 Festivals) ────
      const banner = document.getElementById('utsavBanner');
      const bannerTextEl = document.getElementById('utsavBannerText');
      if (banner && bannerTextEl) {
        if (config.bannerText) {
          bannerTextEl.textContent = config.bannerText;
        } else if (isHalloween) {
          bannerTextEl.textContent = '🎃 Happy Halloween! Spooktacular treats and eerie festive savings await! 👻';
        } else if (isChristmas) {
          bannerTextEl.textContent = '⭐ Merry Christmas! Celebrate the season of warmth, peace, and holiday gifting! 🎄';
        } else if (isValentines) {
          bannerTextEl.textContent = '💖 Happy Valentine\'s Day! Celebrate love with our handpicked gifts! 🌹';
        } else if (isLunar) {
          bannerTextEl.textContent = '🧧 Gong Xi Fa Cai! Wishing you prosperity, good fortune, and happiness! 🐉';
        } else if (isHoli) {
          bannerTextEl.textContent = '🎨 Rang Barse! Happy Holi! Celebrate with joyful vibrant savings! 🌈';
        } else if (isNavratri) {
          bannerTextEl.textContent = '💃 Happy Navratri! Celebrate 9 nights of divine grace and festive deals! ✨';
        } else if (isPongal) {
          bannerTextEl.textContent = '🌾 Happy Pongal! Pongalo Pongal! May abundance overflow in your home! ☀️';
        } else if (isOnam) {
          bannerTextEl.textContent = '🌸 Happy Onam! Onam Ashamsakal! Welcoming King Mahabali with joy! 🌼';
        } else if (isRaksha) {
          bannerTextEl.textContent = '🧵 Happy Raksha Bandhan! Celebrating the sacred bond of love and protection! 🎁';
        } else if (isGanesh) {
          bannerTextEl.textContent = '🐘 Ganpati Bappa Morya! May Lord Ganesha remove all obstacles and bless you! 🙏';
        } else if (isEid) {
          bannerTextEl.textContent = '🌙 Eid Mubarak! May this joyous day bring peace, harmony, and blessings! ✨';
        } else if (isThanksgiving) {
          bannerTextEl.textContent = '🍂 Happy Thanksgiving! Grateful for blessings, family, and festive feasts! 🦃';
        } else if (isHanukkah) {
          bannerTextEl.textContent = '🕎 Chag Hanukkah Sameach! May the festival of lights bring warmth and joy! 🕯️';
        } else if (isEaster) {
          bannerTextEl.textContent = '🐰 Happy Easter! Celebrate spring renewal and joyful holiday surprises! 🌸';
        } else if (isNewYear) {
          bannerTextEl.textContent = '🥂 Happy New Year! Cheers to new beginnings, joy, and incredible savings! 🎆';
        } else if (isMidAutumn) {
          bannerTextEl.textContent = '🥮 Happy Mid-Autumn Festival! May the full moon bring harmony and happiness! 🏮';
        } else if (isVesak) {
          bannerTextEl.textContent = '🪷 Happy Vesak! May peace, compassion, and enlightenment blossom in your life! 🙏';
        } else if (isVishu) {
          bannerTextEl.textContent = '🌟 Happy Vishu! Vishu Ashamsakal! A prosperous and blessed Kerala New Year! 🌺';
        } else if (isDurga) {
          bannerTextEl.textContent = '🔱 Subho Sharodiya! May Maa Durga bless your life with strength, grace, and joy! 🌺';
        } else if (isSankranti) {
          bannerTextEl.textContent = '🪁 Kai Po Che! Happy Makar Sankranti! Soar high with vibrant festive savings! ☀️';
        } else if (isDussehra) {
          bannerTextEl.textContent = '🏹 Shubh Dussehra! Celebrate the victory of Good over Evil with our Festive Collection ✨';
        } else if (isDiwali) {
          bannerTextEl.textContent = '🪔 Shubh Deepavali! May the divine light bring prosperity and joy ✨';
        }
        banner.style.display = 'flex';
      }
    }

    function hideAllEffects() {
      const topContainer = document.getElementById('utsav-top-garland');
      if (topContainer) { topContainer.style.display = 'none'; topContainer.innerHTML = ''; }
      const leftContainer = document.getElementById('utsav-garland-left');
      if (leftContainer) { leftContainer.style.display = 'none'; leftContainer.innerHTML = ''; }
      const rightContainer = document.getElementById('utsav-garland-right');
      if (rightContainer) { rightContainer.style.display = 'none'; rightContainer.innerHTML = ''; }
      const diyaContainer = document.getElementById('utsav-corner-container');
      if (diyaContainer) { diyaContainer.style.display = 'none'; }
      stopFireworks();
      const vignette = document.getElementById('utsavVignette');
      if (vignette) vignette.style.display = 'none';
      const banner = document.getElementById('utsavBanner');
      if (banner) banner.style.display = 'none';
    }

    // ─── 9. Instant Preview or Cloud Activation Detection ───────────────────
    try {
      const urlParams = new URLSearchParams(window.location.search);
      const previewFest = urlParams.get('utsav_preview');
      const shopDomain = '{{ shop.permanent_domain }}' || window.location.hostname;

      if (previewFest) {
        // 1. Render immediate baseline preview
        applyFestival(previewFest.toLowerCase(), {});

        // 2. Query cloud for the merchant's saved customizations for this festival
        fetch('https://utsav-shopify.onrender.com/api/active-theme?shop=' + encodeURIComponent(shopDomain) + '&preview=' + encodeURIComponent(previewFest) + '&_t=' + Date.now())
          .then(r => r.json())
          .then(data => {
            if (data && data.active && data.config) {
              applyFestival(data.festivalId || previewFest.toLowerCase(), data.config);
            }
          })
          .catch(() => {});
        return;
      }

      // If no preview parameter, query cloud activation state with cache-busting
      fetch('https://utsav-shopify.onrender.com/api/active-theme?shop=' + encodeURIComponent(shopDomain) + '&_t=' + Date.now())
        .then(r => r.json())
        .then(data => {
          if (data && data.active === true && data.config) {
            applyFestival(data.festivalId || 'diwali', data.config);
          } else {
            hideAllEffects();
          }
        })
        .catch(() => {
          hideAllEffects();
        });
    } catch(e) {
      hideAllEffects();
    }
  })();
</script>
