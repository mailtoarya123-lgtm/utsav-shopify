<!-- 5. Subtle Aerial Willow Fireworks Engine -->
<canvas id="utsav-fireworks-canvas"></canvas>
<script>
  (function() {
    const canvas = document.getElementById('utsav-fireworks-canvas');
    if (!canvas) return;
    const ctx = canvas.getContext('2d');
    function resize() {
      canvas.width = window.innerWidth;
      canvas.height = window.innerHeight;
    }
    window.addEventListener('resize', resize);
    resize();

    let sparks = [];
    const colors = ["#FFD700", "#FFDF73", "#FFA500", "#FFF8DC", "#FF8C00"];

    function launchSubtleFirework() {
      // Upper 35% margins only to protect product catalog!
      const burstX = Math.random() < 0.5 
        ? 60 + Math.random() * (window.innerWidth * 0.28) 
        : window.innerWidth * 0.68 + Math.random() * (window.innerWidth * 0.26);
      const burstY = 70 + Math.random() * (window.innerHeight * 0.26);
      const count = 28 + Math.floor(Math.random() * 12);

      for (let i = 0; i < count; i++) {
        const angle = Math.random() * Math.PI * 2;
        const speed = 1.0 + Math.random() * 2.2;
        sparks.push({
          x: burstX, y: burstY,
          vx: Math.cos(angle) * speed, vy: Math.sin(angle) * speed,
          color: colors[Math.floor(Math.random() * colors.length)],
          size: 1.2 + Math.random() * 1.5,
          alpha: 1.0,
          decay: 0.012 + Math.random() * 0.01
        });
      }
    }

    setTimeout(launchSubtleFirework, 1200);
    setInterval(launchSubtleFirework, 7500); // Gentle 7.5s interval

    function render() {
      ctx.clearRect(0, 0, canvas.width, canvas.height);
      for (let i = sparks.length - 1; i >= 0; i--) {
        const s = sparks[i];
        s.x += s.vx; s.y += s.vy;
        s.vx *= 0.96; s.vy *= 0.96; s.vy += 0.035;
        s.alpha -= s.decay;
        if (s.alpha > 0) {
          ctx.save();
          ctx.globalAlpha = s.alpha;
          ctx.beginPath();
          ctx.arc(s.x, s.y, s.size, 0, Math.PI * 2);
          ctx.fillStyle = s.color;
          ctx.shadowColor = s.color;
          ctx.shadowBlur = 5;
          ctx.fill();
          ctx.restore();
        } else {
          sparks.splice(i, 1);
        }
      }
      requestAnimationFrame(render);
    }
    render();
  })();
</script>
