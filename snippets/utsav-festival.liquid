            <path d="M 120 14 Q 300 38 480 12 Q 660 36 840 10 Q 1020 34 1140 12" stroke="rgba(255, 255, 255, 0.35)" stroke-width="0.8" stroke-dasharray="3,1" fill="none"/>

            <!-- Left Corner Radial Cobweb Anchor -->
