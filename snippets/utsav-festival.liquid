              <line x1="0" y1="0" x2="160" y2="4" stroke="rgba(255, 255, 255, 0.8)" stroke-width="1.2"/>
              <line x1="0" y1="0" x2="140" y2="28" stroke="rgba(255, 255, 255, 0.7)" stroke-width="1.1"/>
