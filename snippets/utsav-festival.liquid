    }

    function getTopToranSVG(festivalId, garlandStyle, seriesLightsTheme, seriesLightsMode, enableSeriesLights) {
      const fest = (festivalId || '').toLowerCase();
      const isDiwali = fest.includes('diwali');
      const isChristmas = fest.includes('christmas');
      const isVishu = fest === 'vishu';
      const isHalloween = fest.includes('halloween');
      const isValentines = fest.includes('valentines');
      const isLunar = fest.includes('lunar') || fest.includes('chinese');
      const isHoli = fest.includes('holi');
      const isPongal = fest.includes('pongal');
      const isOnam = fest.includes('onam');
      const isRaksha = fest.includes('raksha') || fest.includes('rakhi');
      const isGanesh = fest.includes('ganesh');
      const isEid = fest.includes('eid');
      const isThanksgiving = fest.includes('thanksgiving');
      const isHanukkah = fest.includes('hanukkah');
      const isEaster = fest.includes('easter');
      const isNewYear = fest.includes('new-year') || fest.includes('newyear');
      const isMidAutumn = fest.includes('mid-autumn') || fest.includes('mooncake');
      const isVesak = fest.includes('vesak') || fest.includes('buddha');
      const isDurga = fest.includes('durga');
      const isSankranti = fest.includes('sankranti') || fest.includes('uttarayan');
      const isDussehra = fest.includes('dussehra') || fest.includes('vijayadashami');

      // 1. Halloween: Rich Scalloped Spiderweb Bunting with Glowing Lanterns & Spiders
